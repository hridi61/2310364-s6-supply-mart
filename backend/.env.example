# ---- লোকালে কিছু না দিলেও চলে (SQLite ফাইল + dev কী ব্যবহার হয়) ----
# ---- Vercel-এ নিচের সবগুলো বসাতে হবে ----

# Supabase -> Connect -> Transaction pooler (port 6543)
DATABASE_URL=

# ৩২ অক্ষরের বেশি র‍্যান্ডম লেখা:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# পাসওয়ার্ডের সাথে মেশানো গোপন লেখা (pepper), এটাও র‍্যান্ডম হবে
PEPPER=

# ফ্রন্টএন্ডের URL (CORS এই origin-কেই অনুমতি দেয়), একাধিক হলে কমা দিয়ে
CORS_ORIGINS=https://your-app.vercel.app

# ঐচ্ছিক (ডিফল্ট দেওয়া আছে)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7

# শুধু demo অ্যাকাউন্ট বানানোর স্ক্রিপ্টের জন্য (python -m app.seed_demo)
# DEMO_PASSWORD=
